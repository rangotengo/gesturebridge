{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <=26",
    "npm": ">=10"
  },
  "scripts": {
    "prepare:mediapipe": "node scripts/copy-mediapipe.mjs",
    "predev": "npm run prepare:mediapipe",
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "prebuild": "npm run prepare:mediapipe",
    "build": "next build && npm run build:server",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server.js",
    "lint": "eslint .",
    "type-check": "tsc --project tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/hands": "^0.4.1675469240",
    "@tanstack/react-query": "^5.101.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tar": ">=7.5.21",
    "adm-zip": ">=0.6.0",
    "brace-expansion": ">=1.1.18",
    "nanoid": ">=3.3.18",
    "socket.io-parser": ">=4.2.7",
    "sharp": ">=0.35.0"
  }
}
